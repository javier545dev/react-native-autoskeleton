{
  "name": "autoskeleton",
  "version": "0.1.0",
  "description": "Automatic skeleton loaders for React Native and web",
  "main": "./lib/module/index.js",
  "types": "./lib/typescript/module/src/index.d.ts",
  "exports": {
    ".": {
      "react-native": {
        "types": "./lib/typescript/module/src/index.native.d.ts",
        "default": "./lib/module/index.native.js"
      },
      "browser": {
        "types": "./lib/typescript/module/src/index.web.d.ts",
        "default": "./lib/module/index.web.js"
      },
      "default": {
        "types": "./lib/typescript/module/src/index.d.ts",
        "default": "./lib/module/index.js"
      }
    },
    "./uniwind": {
      "types": "./lib/typescript/module/src/interop/uniwind.d.ts",
      "default": "./lib/module/interop/uniwind.js"
    },
    "./ssr": {
      "types": "./lib/typescript/module/src/index.ssr.d.ts",
      "default": "./lib/module/index.ssr.js"
    },
    "./cli": {
      "default": {
        "types": "./cli/index.ts",
        "default": "./dist-cli/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "autoskeleton-capture": "./dist-cli/capture.js"
  },
  "files": [
    "src",
    "lib",
    "cli",
    "dist-cli",
    "android",
    "ios",
    "cpp",
    "*.podspec",
    "react-native.config.js",
    "expo-module.config.json",
    "!ios/build",
    "!android/build",
    "!android/gradle",
    "!android/gradlew",
    "!android/gradlew.bat",
    "!android/local.properties",
    "!**/__tests__",
    "!**/*.test.js",
    "!**/*.test.js.map",
    "!**/*.test.d.ts",
    "!**/*.test.d.ts.map",
    "!**/*.test.ts",
    "!**/__fixtures__",
    "!**/__mocks__",
    "!**/.*"
  ],
  "scripts": {
    "build:cli": "node scripts/build-cli.mjs",
    "prepare": "bob build && npm run build:cli",
    "typecheck": "tsc && tsc -p tsconfig.tests.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:web": "playwright test",
    "bench": "vitest run -c vitest.bench.config.ts",
    "bench:run": "tsx benchmarks/run.ts",
    "bench:check": "tsx benchmarks/check-budgets.ts",
    "bench:compare": "tsx benchmarks/compare-cli.ts",
    "pack:tarball": "npm pack --pack-destination ./.tarball",
    "clean": "del-cli android/build ios/build lib .tarball"
  },
  "keywords": [
    "react-native",
    "ios",
    "android",
    "skeleton",
    "loading"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/javier545dev/react-native-autoskeleton.git"
  },
  "author": "Javier Fuentes <javierfuentes545@gmail.com> (https://github.com/javier545dev)",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/javier545dev/react-native-autoskeleton/issues"
  },
  "homepage": "https://github.com/javier545dev/react-native-autoskeleton#readme",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@react-native/babel-preset": "0.85.0",
    "@tailwindcss/cli": "^4.3.3",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.5",
    "@vitest/coverage-v8": "^3.2.7",
    "del-cli": "^7.0.0",
    "esbuild": "^0.28.0",
    "react": "19.2.3",
    "react-dom": "^19.2.3",
    "react-native": "0.85.0",
    "react-native-builder-bob": "^0.43.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3",
    "uniwind": "^1.11.0",
    "vite": "^7.3.6",
    "vitest": "^3.2.4"
  },
  "peerDependencies": {
    "@playwright/test": "^1.55.0",
    "@shopify/react-native-skia": "*",
    "react": "*",
    "react-native": "*",
    "react-native-reanimated": "*",
    "uniwind": "*"
  },
  "peerDependenciesMeta": {
    "@playwright/test": {
      "optional": true
    },
    "@shopify/react-native-skia": {
      "optional": true
    },
    "react-native-reanimated": {
      "optional": true
    },
    "uniwind": {
      "optional": true
    }
  },
  "engines": {
    "node": ">= 22.11.0"
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      [
        "commonjs",
        {
          "esm": true
        }
      ],
      [
        "module",
        {
          "esm": true
        }
      ],
      [
        "typescript",
        {
          "project": "tsconfig.build.json"
        }
      ],
      "codegen"
    ]
  },
  "codegenConfig": {
    "name": "AutoskeletonSpec",
    "type": "all",
    "jsSrcsDir": "src",
    "outputDir": {
      "ios": "ios/generated",
      "android": "android/generated"
    },
    "android": {
      "javaPackageName": "com.autoskeleton"
    },
    "ios": {
      "componentProvider": {
        "AutoskeletonOverlayView": "AutoskeletonOverlayView"
      }
    }
  },
  "create-react-native-library": {
    "type": "turbo-module",
    "languages": "kotlin-objc",
    "note": "kotlin-swift is only offered by create-react-native-library 0.63.0 for the type:nitro-module/nitro-view templates, which pull in react-native-nitro-modules — rejected by plan.md ADR-1's zero-dependency requirement. Scaffolded with the turbo-module/kotlin-objc template instead; ios/AutoskeletonSensor.swift (task 3.1) will be authored directly as Swift conforming to the codegen'd Objective-C protocol, which RN turbo modules support natively.",
    "version": "0.63.0"
  }
}
